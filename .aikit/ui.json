{
  "schema": 1,
  "surfaces": {
    "web": {
      "paths": [
        "keystone/web/static/**"
      ]
    }
  },
  "protected": [
    "tests/**"
  ],
  "commands": {
    "fast": "python -m pytest -q tests/test_web.py",
    "snapshot": ""
  },
  "style": {
    "theme_paths": []
  },
  "limits": {
    "max_files": 12,
    "max_lines": 300
  }
}